---
// Tu nie potrzebujemy żadnego server-side logic
---

<div id="page-loader" class="page-loader">
    <div class="loader-spinner"></div>
    <p>Ładowanie...</p>
</div>

<script>
    // Ten skrypt uruchomi się w przeglądarce
    const loader = document.getElementById("page-loader");
    
    if (loader) {
        const hideLoader = () => {
            loader.classList.add("hidden");
            // Czekamy na koniec animacji CSS (transition) zanim usuniemy z layoutu
            setTimeout(() => {
                loader.style.display = "none";
            }, 500);
        };

        // Ukryj po załadowaniu wszystkich zasobów
        window.addEventListener("load", hideLoader);

        // Fallback: Jeśli z jakiegoś powodu load nie odpali w 3 sekundy, ukryj go siłą
        setTimeout(hideLoader, 3000);
    }
</script>