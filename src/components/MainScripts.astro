<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
    
    // --- 1. OBSŁUGA WIDEO (PLAY/PAUSE) ---
    const playIcon = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 5V19L19 12L8 5Z" fill="white"/></svg>`;
    const pauseIcon = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 4H10V20H6V4Z" fill="white"/><path d="M14 4H18V20H14V4Z" fill="white"/></svg>`;

    const videos = document.querySelectorAll(".video-container");

    videos.forEach((container) => {
        const video = container.querySelector("video");
        const btn = container.querySelector(".play-pause-btn");
        if (!video || !btn) return;
        
        btn.innerHTML = playIcon;

        const togglePlay = (e) => {
            e.stopPropagation();
            if (video.paused) {
                // Zatrzymaj inne
                document.querySelectorAll("video").forEach(v => {
                    if(v !== video) {
                        v.pause();
                        const otherBtn = v.closest(".video-container")?.querySelector(".play-pause-btn");
                        if(otherBtn) {
                            otherBtn.innerHTML = playIcon;
                            otherBtn.classList.remove('playing');
                        }
                    }
                });
                
                video.play();
                btn.innerHTML = pauseIcon;
                btn.classList.add('playing');
            } else {
                video.pause();
                btn.innerHTML = playIcon;
                btn.classList.remove('playing');
            }
        };

        btn.addEventListener("click", togglePlay);
        video.addEventListener("click", togglePlay); 

        video.addEventListener("ended", () => {
            btn.innerHTML = playIcon;
            btn.classList.remove('playing');
            video.currentTime = 0;
        });
    });

    // --- 2. ANIMACJE GSAP ---
    if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);

        // Ustawienia początkowe - ukrywamy elementy, żeby mogły "wjechać"
        const elementsToHide = [
            ".nav-menu li", ".social-icons a", ".photo-frame", 
            ".contact-item", ".stat-card", ".offer-card",
            ".welcome-header h2", ".welcome-header p"
        ];
        
        // Ukrywamy tylko te, które istnieją na stronie
        elementsToHide.forEach(selector => {
            if(document.querySelector(selector)) {
                gsap.set(selector, { opacity: 0, y: 30 }); // Lekkie przesunięcie w dół na start
            }
        });

        // Specyficzne ustawienia początkowe (nadpisują powyższe)
        gsap.set(".nav-menu li", { y: -20 });
        gsap.set(".social-icons a", { y: -20, rotation: -180 });
        gsap.set(".photo-frame", { scale: 0.9, rotation: 0, y: 30 });
        gsap.set(".contact-item", { x: -30, y: 0 });
        
        // --- ANIMACJE WEJŚCIA ---

        // 1. Header
        const headerTimeline = gsap.timeline();
        headerTimeline
            .to(".nav-menu li", { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "back.out(1.7)" })
            .to(".social-icons a", { opacity: 1, y: 0, rotation: 0, duration: 0.6, stagger: 0.15, ease: "back.out(1.7)" }, "-=0.4");

        // 2. Karty Video (Photo Gallery)
        const isMobile = window.innerWidth <= 768;
        if (document.querySelector(".photo-gallery")) {
            const framesTimeline = gsap.timeline({
                scrollTrigger: {
                    trigger: ".photo-gallery",
                    start: "top 85%", // Wcześniejszy start animacji
                    toggleActions: "play none none reverse",
                }
            });

            if (isMobile) {
                framesTimeline
                    .to(".photo-frame:nth-child(1)", { opacity: 1, scale: 1, rotation: -5, y: 0, duration: 0.8, ease: "power2.out" })
                    .to(".photo-frame:nth-child(2)", { opacity: 1, scale: 1, rotation: 4, y: 0, duration: 0.8, ease: "power2.out" }, "-=0.6")
                    .to(".photo-frame:nth-child(3)", { opacity: 1, scale: 1, rotation: -6, y: 0, duration: 0.8, ease: "power2.out" }, "-=0.6")
                    .to(".photo-frame:nth-child(4)", { opacity: 1, scale: 1, rotation: 5, y: 0, duration: 0.8, ease: "power2.out" }, "-=0.6");
            } else {
                framesTimeline.to(".photo-frame", { opacity: 1, scale: 1, y: 0, duration: 0.8, stagger: 0.15, ease: "power2.out" });
            }
        }

        // 3. Welcome Section
        if (document.querySelector(".welcome-section")) {
            gsap.timeline({
                scrollTrigger: { trigger: ".welcome-section", start: "top 80%" }
            })
            .to(".welcome-header h2", { opacity: 1, y: 0, duration: 0.8 })
            .to(".welcome-header p", { opacity: 1, y: 0, duration: 0.6 }, "-=0.4");
        }

        // 4. Oferta (Karty)
        if (document.querySelector(".offer-card")) {
            ScrollTrigger.batch(".offer-card", {
                onEnter: elements => gsap.to(elements, { 
                    opacity: 1, y: 0, duration: 0.8, stagger: 0.15, ease: "back.out(1.2)" 
                }),
                start: "top 85%"
            });
        }

        // --- STATYSTYKI (LICZNIK) ---
        // Naprawia brak animacji cyferek
        if (document.querySelector(".stats-section")) {
            // Najpierw pokaż karty
            gsap.timeline({
                scrollTrigger: { trigger: ".stats-section", start: "top 80%" }
            }).to(".stat-card", { opacity: 1, y: 0, duration: 0.8, stagger: 0.1 });

            // Potem animuj liczby
            const stats = document.querySelectorAll('.stat-number');
            stats.forEach(stat => {
                const rawValue = stat.getAttribute('data-final-value') || stat.textContent;
                // Wyciągnij liczbę (np. "200" z "200+")
                const numberMatch = rawValue.match(/(\d+)/);
                
                if (numberMatch) {
                    const endValue = parseInt(numberMatch[0], 10);
                    const suffix = rawValue.replace(numberMatch[0], ''); // np. "+" lub " lat"
                    
                    // Reset do 0 na start
                    stat.textContent = '0' + suffix;

                    ScrollTrigger.create({
                        trigger: stat,
                        start: "top 90%", // Uruchom gdy element widoczny
                        once: true, // Tylko raz
                        onEnter: () => {
                            const obj = { val: 0 };
                            gsap.to(obj, {
                                val: endValue,
                                duration: 2,
                                ease: "power2.out",
                                onUpdate: () => {
                                    stat.textContent = Math.round(obj.val) + suffix;
                                }
                            });
                        }
                    });
                } else {
                    // Jeśli to np. znak nieskończoności, po prostu go pokaż
                    stat.textContent = rawValue;
                }
            });
        }

        // 6. Kontakt
        const footer = document.querySelector("#contact");
        if (footer) {
            gsap.timeline({
                scrollTrigger: { trigger: "#contact", start: "top 90%" } 
            })
            .to(".contact-item", { opacity: 1, x: 0, duration: 0.8, stagger: 0.15 });
        }

        // Navbar scroll effect
        const header = document.querySelector(".header");
        window.addEventListener("scroll", () => {
            if(window.scrollY > 50) header?.classList.add("scrolled");
            else header?.classList.remove("scrolled");
        });

        // WAŻNE: Odśwież ScrollTrigger po załadowaniu wszystkiego (naprawia "drewniane" wejścia)
        window.addEventListener("load", () => ScrollTrigger.refresh());
    }
});
</script>