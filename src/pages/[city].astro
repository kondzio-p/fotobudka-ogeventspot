---
export const prerender = false;

import SitePage from '../components/SitePage.astro';
import { loadPages, cityList } from '../lib/pages';

const { city } = Astro.params;
const pages = await loadPages();
const page = pages.find((p) => p.slug === city);

if (!page || city === 'home') {
	return new Response(null, { status: 404, statusText: 'Nie znaleziono miasta' });
}

const home = pages.find((p) => p.slug === 'home') || {};
---
<SitePage page={page} home={home} cities={cityList(pages)} isHome={false} />
