---
import '../../styles/bootstrap.min.css';
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>Manager Plików (Lokalny)</title>
    <style>
        body { background: #f4f6f9; padding: 2rem; }
        .container { max-width: 1000px; margin: 0 auto; background: white; padding: 2rem; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        
        .file-list { display: flex; flex-direction: column; gap: 8px; margin-top: 20px; }
        .file-row { 
            display: flex; align-items: center; justify-content: space-between; 
            padding: 10px 15px; border: 1px solid #eee; border-radius: 6px; 
            background: #fff; transition: background 0.2s;
        }
        .file-row:hover { background: #f8f9fa; border-color: #ddd; }
        
        .file-name { font-weight: 500; color: #333; word-break: break-all; margin-right: 15px; }
        .file-actions { display: flex; gap: 10px; flex-shrink: 0; }
        
        .copy-btn { background: #e9ecef; color: #333; border: 1px solid #ced4da; padding: 4px 12px; border-radius: 4px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
        .copy-btn:hover { background: #dde0e3; }
        
        .delete-btn { background: rgba(220,53,69,0.1); color: #dc3545; border: 1px solid rgba(220,53,69,0.3); padding: 4px 12px; border-radius: 4px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
        .delete-btn:hover { background: #dc3545; color: white; }

        .nav-tabs .nav-link { color: #495057; }
        .nav-tabs .nav-link.active { color: #801039; font-weight: bold; border-color: #dee2e6 #dee2e6 #fff; }
    </style>
</head>
<body>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Magazyn Plików (Lokalny)</h2>
            <a href="/admin" class="btn btn-outline-secondary btn-sm">← Wróć do Panelu</a>
        </div>

        <div class="mb-5 p-4 bg-light rounded border">
            <h5 class="mb-3 text-secondary">Wgraj na serwer (public/media)</h5>
            <form id="upload-form" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Folder</label>
                    <select id="folder-select" class="form-select">
                        <option value="gallery">Zdjęcia (.webp)</option>
                        <option value="videos">Filmy (.webm)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Wybierz pliki (Max 10MB)</label>
                    <input type="file" id="file-input" class="form-control" multiple>
                </div>
                <div class="col-md-2">
                    <button type="submit" id="upload-btn" class="btn btn-primary w-100" style="background-color: #801039; border: none;">Wgraj</button>
                </div>
            </form>
        </div>

        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item"><button class="nav-link active" id="img-tab" data-bs-toggle="tab" data-bs-target="#img-pane" type="button">Zdjęcia</button></li>
            <li class="nav-item"><button class="nav-link" id="vid-tab" data-bs-toggle="tab" data-bs-target="#vid-pane" type="button">Filmy</button></li>
        </ul>
        
        <div class="tab-content pt-3 border-start border-end border-bottom p-3 rounded-bottom">
            <div class="tab-pane fade show active" id="img-pane">
                <div id="gallery-list" class="file-list"><div class="text-center p-3">Ładowanie...</div></div>
            </div>
            <div class="tab-pane fade" id="vid-pane">
                <div id="video-list" class="file-list"><div class="text-center p-3">Ładowanie...</div></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        import { supabase } from '../../lib/supabase';

        // 1. Sprawdź logowanie (dla bezpieczeństwa, żeby nikt obcy nie wchodził)
        supabase.auth.getSession().then(({ data: { session } }) => {
            if (!session) window.location.href = '/admin/login';
        });

        // 2. Pobierz pliki z LOKALNEGO API
        async function loadFiles() {
            // Zdjęcia
            const resImg = await fetch('/api/files?folder=gallery');
            const imgFiles = await resImg.json();
            renderFiles(imgFiles, 'gallery', 'gallery-list');

            // Filmy
            const resVid = await fetch('/api/files?folder=videos');
            const vidFiles = await resVid.json();
            renderFiles(vidFiles, 'videos', 'video-list');
        }

        function renderFiles(files, folder, containerId) {
            const container = document.getElementById(containerId);
            
            if(!files || files.length === 0) {
                container.innerHTML = '<p class="text-muted p-2">Brak plików.</p>';
                return;
            }

            container.innerHTML = files.map(file => `
                <div class="file-row">
                    <div class="file-name" title="${file.name}">
                        <a href="${file.url}" target="_blank" style="text-decoration: none; color: inherit;">${file.name}</a>
                    </div>
                    <div class="file-actions">
                        <button class="copy-btn" onclick="copyToClipboard('${file.url}', this)">Kopiuj Link</button>
                        <button class="delete-btn" onclick="deleteFile('${folder}', '${file.name}')">Usuń</button>
                    </div>
                </div>`
            ).join('');
        }

        // 3. Upload (przez API)
        const form = document.getElementById('upload-form');
        const uploadBtn = document.getElementById('upload-btn');
        const fileInput = document.getElementById('file-input');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const folder = document.getElementById('folder-select').value;
            const files = fileInput.files;

            if(files.length === 0) return alert("Wybierz pliki!");

            uploadBtn.disabled = true;
            uploadBtn.textContent = 'Wgrywanie...';

            try {
                for (const file of files) {
                    // Walidacja 10MB
                    if (file.size > 10 * 1024 * 1024) { 
                        alert(`Pominięto ${file.name} (za duży)`); continue; 
                    }
                    if (folder === 'gallery' && !file.type.includes('webp')) { alert('Zdjęcia muszą być .webp'); continue; }
                    if (folder === 'videos' && !file.type.includes('webm')) { alert('Filmy muszą być .webm'); continue; }

                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('folder', folder);

                    // Wysyłamy do naszego API
                    const res = await fetch('/api/upload', {
                        method: 'POST',
                        body: formData
                    });

                    if (!res.ok) {
                        const err = await res.json();
                        throw new Error(err.error || 'Błąd uploadu');
                    }
                }
            } catch (err) {
                alert('Błąd: ' + err.message);
            }

            uploadBtn.disabled = false;
            uploadBtn.textContent = 'Wgraj';
            fileInput.value = '';
            loadFiles(); // Odśwież listę
        });

        // 4. Usuwanie (przez API)
        window.deleteFile = async (folder, name) => {
            if(!confirm(`Usunąć ${name}?`)) return;
            
            try {
                const res = await fetch('/api/files', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ folder, name })
                });
                
                if(res.ok) loadFiles();
                else alert('Błąd usuwania');
            } catch(e) {
                alert('Błąd sieci: ' + e.message);
            }
        };

        window.copyToClipboard = (text, btn) => {
            // Dodajemy pełny adres domeny jeśli ścieżka jest relatywna (dla wygody)
            const fullUrl = window.location.origin + text;
            navigator.clipboard.writeText(text).then(() => {
                const originalText = btn.textContent;
                btn.textContent = "Skopiowano!";
                btn.style.background = "#198754";
                btn.style.color = "white";
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = "";
                    btn.style.color = "";
                }, 1500);
            });
        };

        loadFiles();
    </script>
</body>
</html>